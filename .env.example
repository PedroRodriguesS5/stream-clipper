# Twitch Stream & Chat Sensor
# "auto" = pick the biggest live stream in TARGET_CATEGORY spoken in STREAM_LANGUAGE
TWITCH_CHANNEL=auto
# Categories to clip (comma separated). Use "any" to test with every category.
TARGET_CATEGORIES=Grand Theft Auto VI
# Channels watched at the same time, and clips processed at the same time (Claude + FFmpeg)
MAX_CHANNELS=5
MAX_CONCURRENT_JOBS=1
# true = render and check everything but never upload (same as `npm start -- --dry-run`)
DRY_RUN=false
STREAM_LANGUAGE=PT
# Chat validation adapts to channel size: auto | small (<100 viewers) | normal | big (>2000)
CHAT_TIER=auto
# Categories scanned by `npm run scan:permissions` (comma separated)
SCAN_CATEGORIES=Grand Theft Auto VI,Grand Theft Auto V,Just Chatting,Minecraft,Counter-Strike,VALORANT,League of Legends,Fortnite

# Clip length in seconds (TikTok Creator Rewards only pays for videos > 60 s; Shorts max 180 s)
CLIP_MIN_SECONDS=62
CLIP_MAX_SECONDS=90

# Who can be clipped: denylist = every PT channel except blocked ones (npm run block -- <login>)
#                     allowlist = only channels marked "allowed" in data/clip-permissions.json
PERMISSION_MODE=denylist
# Growth mode: also post clips that pass every safety/copyright check but can't earn money yet
# (accounts not in the programs, TikTok < 60 s, no webcam). Turn off once monetized.
GROWTH_MODE=true

# Set to true only after the account is accepted in the program (the APIs can't tell us).
YOUTUBE_PARTNER_PROGRAM=false
TIKTOK_CREATOR_REWARDS=false
# YouTube upload: browser (YouTube Studio + cookies/youtube.json, really public)
#                 api (Data API; YouTube locks it to PRIVATE unless the Google project passed the API audit)
YOUTUBE_UPLOAD_METHOD=browser
YOUTUBE_COOKIES_PATH=./cookies/youtube.json
# private | unlisted | public (api method only)
YOUTUBE_PRIVACY=private

# Language/locale for titles, descriptions & hashtags (pt-BR or pt-PT)
CONTENT_LOCALE=pt-BR

# Vertical video layout: auto | stack | blur | center
#   auto  = AI finds the webcam in a frame; webcam on top, gameplay below
#   stack = same, but uses FACECAM_REGION / GAMEPLAY_REGION you provide
#   blur  = whole 16:9 frame over a blurred background (never cuts anything)
#   center = old behaviour, plain center crop
VIDEO_LAYOUT=auto
# Optional manual boxes as fractions of the frame: x,y,width,height (0-1)
FACECAM_REGION=
GAMEPLAY_REGION=

# Whisper speech subtitles burned into every clip (local, free).
# Setup: brew install whisper-cpp, then put the models in ./models (see PROJECT_GUIDE.md).
# auto = on when the model file exists; off = never
SUBTITLES=auto
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
WHISPER_VAD_MODEL=models/ggml-silero-v5.1.2.bin

# Claude Code CLI Agent (No API Key Needed!)
CLAUDE_CLI_PATH=claude

# 9Router Local OpenAI-Compatible Endpoint (SEO Metadata & Fallback)
NINEROUTER_ENDPOINT=http://localhost:20128/v1/chat/completions
NINEROUTER_MODEL=code
NINEROUTER_API_KEY=dummy

# Google / YouTube Data API v3 OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# TikTok Session Cookies (Path to Cookie-Editor JSON export or raw sessionid)
TIKTOK_COOKIES_PATH=./cookies/tiktok.json
TIKTOK_SESSION_COOKIE=

# Instagram Reels (optional). When both are set, every approved clip is also queued as a Reel.
# Needs an Instagram Business/Creator account linked to a Facebook Page, and a Meta app using
# Facebook Login for Business with: instagram_basic, instagram_content_publish, pages_read_engagement.
# Uploads go straight from the local file (resumable upload): no public video URL needed.
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account id (GET /me/accounts?fields=instagram_business_account)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v27.0
# Set to false to keep the credentials but stop posting Reels
INSTAGRAM_ENABLED=true

# Post queue: daily plan per platform (5-10 posts/day)
# Slots are spread over POST_HOURS (local time): 13 h / 10 posts = one slot every ~78 min.
# Between slots clips pile up and the most viral one wins (score, +2 priority channel, -0.5/h waiting).
POSTS_PER_DAY_MIN=5
POSTS_PER_DAY_MAX=10
# Per-platform override, e.g. a TikTok account that is being held back:
# POSTS_PER_DAY_MAX_TIKTOK=5
POST_HOURS=10-23
# Viral bar: only clips scored >= this are posted. When a platform is behind the daily
# minimum pace it drops to MIN_VIRALITY_SCORE so the day still reaches POSTS_PER_DAY_MIN.
MIN_POST_SCORE=8
# Disk: delete output/clip_*.mp4 once every platform it was queued for is done and it was posted
# somewhere (the .seo.json/.srt metadata is kept). `npm run cleanup:clips -- --dry-run` lists them.
DELETE_CLIPS_AFTER_POST=true
# Also delete clips that were never posted (expired in the queue / blocked) after N hours. 0 = keep
DELETE_UNPOSTED_CLIPS_AFTER_HOURS=0
# Hard floor between two posts on the same platform (the daily plan usually spaces them more)
MIN_MINUTES_BETWEEN_POSTS=10
MAX_QUEUE_AGE_HOURS=3
# Clips Claude scores below this (1-10: how likely a stranger watches to the end) are not posted.
# Gameplay chaos/fails/discoveries score high; waiting screens, menus and talking score low.
MIN_VIRALITY_SCORE=6
